# Copy to .env. Nothing here is needed for the offline demo (npm run demo).

# ---- App ----
PORT=8787
# Public URL (needed for CRE nodes to reach /guard/snapshot and for X / Telegram link previews)
PUBLIC_URL=http://localhost:8787
DB_PATH=tribe.db
# true = offline demo prices and the /demo sign-in
DEMO=false
# Testing: the swipe deck never runs dry (skipped trades come back round). On by default when DEMO=true; set false to turn off.
# DECK_LOOP=true
# true = simulated fills and balances; false = real Flash orders onchain
DRY_RUN=true
# Signs login links and session cookies (defaults to CRE_SHARED_SECRET)
SESSION_SECRET=

# ---- Flash (https://flash.definitive.fi/docs) ----
# Empty = Flash's public dev key. Your own key (app.definitive.fi -> More -> Flash) makes Tribe the integrator of record and pays it the fee.
FLASH_API_KEY=
# Integrator fee on every order, in basis points (max 1000). Creators get CREATOR_SHARE of it.
FLASH_FEE_BPS=50
CREATOR_SHARE=0.5
# Optional Base builder code for ERC-8021 attribution on settlement transactions
BASE_BUILDER_CODE=
# Base mainnet RPC for approvals Flash can't broadcast itself (attached-bracket exits); defaults to https://mainnet.base.org
BASE_RPC=
# Live demo: a funded Base mainnet wallet (USDC + a little ETH). The user below trades from it. Fresh wallet only.
LIVE_WALLET_PRIVATE_KEY=
LIVE_WALLET_HANDLE=you

# ---- Chainlink CRE ----
# Shared secret the CRE workflows send to /guard/snapshot, /cre/guard and /cre/signal (same value as TRIBE_SECRET_ENV in cre-workflow/.env)
CRE_SHARED_SECRET=change-me
# CopyGuard contract (npm run guard:deploy fills these in)
GUARD_ADDRESS=
GUARD_CHAIN=base-sepolia
GUARD_RPC=
# Dead-man's switch: if CRE hasn't reported for this many minutes, auto-copies wait for approval.
# Defaults to 30 once GUARD_ADDRESS is set, otherwise off. Set 0 to disable (e.g. when you only run the workflow by hand).
GUARD_MAX_SILENCE_MIN=
# Base Sepolia wallet with test ETH, used by npm run guard:deploy
DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ---- Optional ----
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=TribeTradeBot
# Ask Cat's AI for understanding trade requests (falls back to rules without one). Any OpenAI-compatible API
# takes priority, e.g. OpenRouter with a cheap model; otherwise Anthropic.
OPENAI_COMPAT_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_MODEL=openai/gpt-oss-20b
OPENAI_COMPAT_API_KEY=
ANTHROPIC_API_KEY=
ASK_MODEL=
# Ranking eligibility (ignored when DEMO=true)
RANK_MIN_DAYS=14
RANK_MIN_TRADES=10
